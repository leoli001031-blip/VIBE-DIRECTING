{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecore.local/schemas/director_skill_registry.schema.json",
  "title": "DirectorSkillRegistry",
  "description": "Isolated user-global Director Skill registry with immutable versions, active/pinned pointers, evidence summaries, and operation receipts.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "registryHash", "scope", "createdAt", "updatedAt", "entries", "operationReceipts"],
  "properties": {
    "schemaVersion": { "const": "director_skill_registry/1.0.0" }, "registryId": { "type": "string", "minLength": 1 }, "registryHash": { "type": "string", "minLength": 1 },
    "scope": { "const": "user_global" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "operationReceipts": { "type": "array", "items": { "$ref": "director_skill_registry_operation.schema.json" } }
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["skillId", "activeVersion", "enabled", "versions"],
      "properties": {
        "skillId": { "type": "string", "minLength": 1 }, "activeVersion": { "type": "string", "minLength": 1 }, "pinnedVersion": { "type": "string" },
        "enabled": { "type": "boolean" }, "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      }
    },
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "contentHash", "maturity", "definition", "recipes", "evidence", "installedAt"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }, "contentHash": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["candidate", "verified", "trusted", "deprecated"] },
        "definition": { "$ref": "director_skill_definition.schema.json" }, "recipes": { "type": "array", "items": { "$ref": "director_skill_recipe.schema.json" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "installedAt": { "type": "string", "format": "date-time" },
        "supersedesVersion": { "type": "string" }, "deprecatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["caseId", "caseHash", "projectIdHash", "shotIdHash", "acceptedAt"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 }, "caseHash": { "type": "string", "minLength": 1 }, "projectIdHash": { "type": "string", "minLength": 1 },
        "shotIdHash": { "type": "string", "minLength": 1 }, "qaReportHash": { "type": "string" }, "acceptedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
