{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecore.local/schemas/director_skill_invocation_receipt.schema.json",
  "title": "DirectorSkillInvocationReceipt",
  "description": "Current-fact-bound evidence for one Director Skill recommendation, selection, injection, or QA validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "receiptHash", "projectId", "projectRoot", "projectFactHash", "shotId", "actionId", "jobId",
    "skillId", "skillVersion", "skillContentHash", "status", "routeId", "routingReasons", "inputHash", "outputHash",
    "knowledgePacks", "provider", "qa", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "director_skill_invocation_receipt/1.0.0" },
    "receiptId": { "type": "string", "minLength": 1 },
    "receiptHash": { "type": "string", "pattern": "^vdsh_[a-f0-9]{8}$" },
    "projectId": { "type": "string", "minLength": 1 }, "projectRoot": { "type": "string", "minLength": 1 }, "projectFactHash": { "type": "string", "minLength": 1 },
    "shotId": { "type": "string", "minLength": 1 }, "actionId": { "type": "string", "minLength": 1 }, "jobId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 }, "skillVersion": { "type": "string", "minLength": 1 }, "skillContentHash": { "type": "string", "minLength": 1 },
    "status": { "enum": ["recommended", "selected", "injected", "validated", "rejected", "blocked"] },
    "routeId": { "type": "string", "minLength": 1 }, "routingReasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "inputHash": { "type": "string", "minLength": 1 }, "outputHash": { "type": "string", "minLength": 1 },
    "knowledgePacks": { "type": "array", "items": { "$ref": "director_skill_case.schema.json#/$defs/knowledgeBinding" } },
    "provider": { "$ref": "director_skill_case.schema.json#/$defs/providerBinding" },
    "qa": { "$ref": "director_skill_case.schema.json#/$defs/qaEvidence" },
    "humanDecision": { "$ref": "director_skill_case.schema.json#/$defs/humanDecision" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
