{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecore.local/schemas/director_skill_injection.schema.json",
  "title": "DirectorSkillInjection",
  "description": "Bounded Planner, Prompt Compiler, and QA injection produced by a Director Skill route. Authorization fields are pinned false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routeId", "routeInputHash", "plannerGuidance", "image2PromptFragments", "seedancePromptFragments", "qaChecks", "injectedSkillIds", "injectedRuleCount", "usedTokens", "truncated", "truncationReasons", "executionAuthorized", "providerSubmitAuthorized"],
  "properties": {
    "schemaVersion": { "const": "director_skill_injection/1.0.0" },
    "routeId": { "type": "string", "minLength": 1 }, "routeInputHash": { "type": "string", "minLength": 1 },
    "plannerGuidance": { "$ref": "#/$defs/stringArray" }, "image2PromptFragments": { "$ref": "#/$defs/stringArray" }, "seedancePromptFragments": { "$ref": "#/$defs/stringArray" },
    "qaChecks": { "type": "array", "items": { "$ref": "director_skill_definition.schema.json#/$defs/qaCheck" } },
    "compilerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["skillId", "version", "contentHash", "recipeId", "recipeVersion", "recipeContentHash", "knowledgePacks", "injectedRulesHash"],
      "properties": {
        "skillId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "contentHash": { "type": "string", "minLength": 1 },
        "recipeId": { "type": "string", "minLength": 1 }, "recipeVersion": { "type": "string", "minLength": 1 }, "recipeContentHash": { "type": "string", "minLength": 1 },
        "knowledgePacks": { "type": "array", "items": { "$ref": "director_skill_case.schema.json#/$defs/knowledgeBinding" } },
        "injectedRulesHash": { "type": "string", "minLength": 1 }
      }
    },
    "injectedSkillIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "injectedRuleCount": { "type": "integer", "minimum": 0 },
    "usedTokens": { "type": "integer", "minimum": 0 }, "truncated": { "type": "boolean" }, "truncationReasons": { "$ref": "#/$defs/stringArray" },
    "executionAuthorized": { "const": false }, "providerSubmitAuthorized": { "const": false }
  },
  "$defs": { "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
}
